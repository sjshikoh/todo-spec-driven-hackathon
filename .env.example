# Database Configuration
# Replace with your actual Neon connection string
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Auth Configuration
# URL of your Next.js app running Better Auth (production URL)
BETTER_AUTH_URL=https://your-frontend-domain.com

# Server Configuration
HOST=0.0.0.0
PORT=8000

# JWT Configuration (if using custom JWT)
# JWT_SECRET_KEY=your-secret-key-here
# JWT_ALGORITHM=HS256

# CORS Origins (comma separated for production)
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://admin.your-domain.com

# Logging Level
LOG_LEVEL=INFO

# Development/Production Mode
ENVIRONMENT=production